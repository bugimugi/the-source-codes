{
  "name": "the-source-codes",
  "version": "0.1.0",
  "description": "THE SOURCE CODES \u2013 investigative field documentation with graded evidence",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --experimental-strip-types scripts/validate.ts",
    "report": "node --experimental-strip-types scripts/validate.ts --report",
    "release:check": "node --experimental-strip-types scripts/release-check.ts",
    "review:export": "node --experimental-strip-types scripts/export-review.ts",
    "build:release": "npm run release:check && npm run build",
    "assets:list": "node --experimental-strip-types scripts/assets-list.ts"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "gsap": "^3.12.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/three": "*",
    "typescript": "*",
    "vite": "*"
  }
}
